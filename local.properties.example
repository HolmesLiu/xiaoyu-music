# local.properties — not committed to git
# Copy this file to local.properties and adjust paths
#
# Android SDK location
# macOS default:
#   sdk.dir=/Users/yourname/Library/Android/sdk
# Linux default:
#   sdk.dir=/home/yourname/Android/Sdk
# Windows default:
#   sdk.dir=C\:\\Users\\yourname\\AppData\\Local\\Android\\Sdk
#
# This file is auto-generated by Android Studio on first import.
# For CI, ANDROID_HOME env var is used instead.
